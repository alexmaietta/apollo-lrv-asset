newmtl aluminium_spun
Ka 1.000000 1.000000 1.000000
Ks 0.500000 0.500000 0.500000
Ke 0.000000 0.000000 0.000000
Ni 1.500000
d 1.000000
illum 3
map_Kd -s 6.6666665 6.6666665 1 aluminium_spun_basecolor.png
map_Ns -s 6.6666665 6.6666665 1 aluminium_spun_roughness.png
map_Bump -s 6.6666665 6.6666665 1 -bm 0.300000 aluminium_spun_normal.png

newmtl eq_copper_strap
Ka 1.000000 1.000000 1.000000
Ks 0.500000 0.500000 0.500000
Ke 0.000000 0.000000 0.000000
Ni 1.500000
d 1.000000
illum 3
map_Kd -s 4 4 1 eq_copper_strap_basecolor.png
map_Ns -s 4 4 1 eq_copper_strap_roughness.png
map_Bump -s 4 4 1 -bm 0.600000 eq_copper_strap_normal.png

