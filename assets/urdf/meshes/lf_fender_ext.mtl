Ks 0.500000 0.500000 0.500000
Ke 0.000000 0.000000 0.000000
Ni 1.500000
d 1.000000
illum 2
map_Kd -s 3.3333333 3.3333333 1 fiberglass_fender_basecolor.png
map_Ns -s 3.3333333 3.3333333 1 fiberglass_fender_roughness.png
map_refl -s 3.3333333 3.3333333 1 fiberglass_fender_metallic.png
map_Bump -s 3.3333333 3.3333333 1 -bm 0.600000 fiberglass_fender_normal.png

newmtl fender_ext
