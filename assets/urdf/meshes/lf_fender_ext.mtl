# Blender 5.2.2 LTS MTL File: 'lrv.blend'
# www.blender.org

newmtl brass
Ka 1.000000 1.000000 1.000000
Ks 0.500000 0.500000 0.500000
Ke 0.000000 0.000000 0.000000
Ni 1.500000
d 1.000000
illum 3
map_Kd -s 3.3333333 3.3333333 1 brass_basecolor.png
map_Ns -s 3.3333333 3.3333333 1 brass_roughness.png
map_Bump -s 3.3333333 3.3333333 1 -bm 0.600000 brass_normal.png

newmtl fender
