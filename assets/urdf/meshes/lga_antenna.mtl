# Blender 5.2.2 LTS MTL File: 'lrv.blend'
# www.blender.org

newmtl aluminium
Ka 1.000000 1.000000 1.000000
Ks 0.500000 0.500000 0.500000
Ke 0.000000 0.000000 0.000000
Ni 1.500000
d 1.000000
illum 3
map_Kd -s 2.5 2.5 1 aluminium_basecolor.png
map_Ns -s 2.5 2.5 1 aluminium_roughness.png
map_Bump -s 2.5 2.5 1 -bm 0.400000 aluminium_normal.png

newmtl eq_cable_white
Ka 1.000000 1.000000 1.000000
Ks 0.500000 0.500000 0.500000
Ke 0.000000 0.000000 0.000000
Ni 1.500000
d 1.000000
illum 2
map_Kd -s 10 10 1 eq_cable_white_basecolor.png
map_Ns -s 10 10 1 eq_cable_white_roughness.png
map_Bump -s 10 10 1 -bm 0.600000 eq_cable_white_normal.png

newmtl eq_red_anodized
Ka 0.300000 0.300000 0.300000
Ks 0.500000 0.500000 0.500000
Ke 0.000000 0.000000 0.000000
Ni 1.500000
d 1.000000
illum 3
map_Kd -s 10 10 1 eq_red_anodized_basecolor.png
map_Ns -s 10 10 1 eq_red_anodized_roughness.png
map_Bump -s 10 10 1 -bm 0.600000 eq_red_anodized_normal.png

newmtl white_paint
Ka 1.000000 1.000000 1.000000
Ks 0.500000 0.500000 0.500000
Ke 0.000000 0.000000 0.000000
Ni 1.500000
d 1.000000
illum 2
map_Kd -s 3.3333333 3.3333333 1 white_paint_basecolor.png
map_Ns -s 3.3333333 3.3333333 1 white_paint_roughness.png
map_Bump -s 3.3333333 3.3333333 1 -bm 0.300000 white_paint_normal.png
