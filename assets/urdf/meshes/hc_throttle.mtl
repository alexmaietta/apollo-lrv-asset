newmtl crew_cb_knob
Ka 1.000000 1.000000 1.000000
Ks 0.500000 0.500000 0.500000
Ke 0.000000 0.000000 0.000000
Ni 1.500000
d 1.000000
illum 2
map_Kd -s 10 10 1 crew_cb_knob_basecolor.png
map_Ns -s 10 10 1 crew_cb_knob_roughness.png
map_Bump -s 10 10 1 -bm 0.600000 crew_cb_knob_normal.png

