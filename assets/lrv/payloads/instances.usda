{
    def Xform "rf_damper_cyl" (
        prepend references = @./geometries.usd@</Geometries/rf_damper_cyl>
    )
    {
        def Scope "VisualMaterials"
        {
            def Material "damper" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/damper>
            )
            {
            }
        }

        over "rf_damper_cyl" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </Instances/rf_damper_cyl/VisualMaterials/damper>
        }
    }

