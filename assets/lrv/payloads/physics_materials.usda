#usda 1.0
(
    customLayerData = {
        string creator = "lrv pipeline (scripts/package_usd.py)"
    }
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Scope "PhysicsMaterials"
{
    def Material "wheel_mesh" (
        prepend apiSchemas = ["PhysicsMaterialAPI", "NewtonMaterialAPI"]
    )
    {
        float newton:rollingFriction = 0.0001
        float newton:torsionalFriction = 0.005
        float physics:dynamicFriction = 0.8
        float physics:restitution = 0
        float physics:staticFriction = 0.9
    }

    def Material "aluminium" (
        prepend apiSchemas = ["PhysicsMaterialAPI", "NewtonMaterialAPI"]
    )
    {
        float newton:rollingFriction = 0.0001
        float newton:torsionalFriction = 0.005
        float physics:dynamicFriction = 0.4
        float physics:restitution = 0
        float physics:staticFriction = 0.5
    }
}

