#usda 1.0
(
    customLayerData = {
        string creator = "lrv pipeline (scripts/package_usd.py)"
    }
    defaultPrim = "lrv"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "lrv"
{
    over "Geometry"
    {
        over "chassis" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysicsArticulationRootAPI", "NewtonArticulationRootAPI", "PhysxArticulationAPI"]
        )
        {
            bool physxArticulation:enabledSelfCollisions = 0
            int physxArticulation:solverPositionIterationCount = 32
            int physxArticulation:solverVelocityIterationCount = 1
        }
    }

    over "Physics"
    {
        over "chassis_aft" (
            prepend apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular", "PhysxJointAPI"]
        )
        {
            float physxJoint:maxJointVelocity = 360
        }

        over "aft_steer_sector" (
            prepend apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular", "PhysxJointAPI"]
        )
        {
            float physxJoint:maxJointVelocity = 360
        }

        over "lr_tie_rod" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:maxJointVelocity = 360
        }

        over "rr_tie_rod" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:maxJointVelocity = 360
        }

        over "lr_damper_cyl" (
            prepend apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular", "PhysxJointAPI"]
        )
        {
            float physxJoint:maxJointVelocity = 360
        }

        over "lr_damper_rod" (
            prepend apiSchemas = ["PhysicsJointStateAPI:linear", "PhysicsDriveAPI:linear", "PhysxJointAPI"]
        )
        {
            float physxJoint:maxJointVelocity = 1
        }

        over "lr_lower_arm" (
            prepend apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular", "PhysxJointAPI"]
        )
        {
            float physxJoint:maxJointVelocity = 360
        }

        over "lr_upright" (
            prepend apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular", "PhysxJointAPI"]
        )
        {
            float physxJoint:maxJointVelocity = 360
        }

        over "lr_steer" (
            prepend apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular", "PhysxJointAPI"]
        )
        {
            float physxJoint:maxJointVelocity = 360
        }

        over "lr_fender_ext" (
            prepend apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular", "PhysxJointAPI"]
        )
        {
            float physxJoint:maxJointVelocity = 360
        }

        over "lr_wheel" (
            prepend apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular", "PhysxJointAPI"]
        )
        {
            float physxJoint:maxJointVelocity = 817.17694
        }

        over "lr_upper_arm" (
            prepend apiSchemas = ["PhysicsJointStateAPI:angular", "PhysicsDriveAPI:angular", "PhysxJointAPI"]
        )
        {
