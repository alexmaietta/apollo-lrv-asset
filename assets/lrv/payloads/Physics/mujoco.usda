#usda 1.0
(
    customLayerData = {
        string creator = "lrv pipeline (scripts/package_usd.py)"
    }
    defaultPrim = "lrv"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "lrv"
{
    over "Physics"
    {
        over "chassis_aft" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
            uniform double mjc:armature = 0.01
        }

        def MjcActuator "chassis_aft_actuator"
        {
            uniform double[] mjc:biasPrm = [0, -200000, -2000, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:biasType = "affine"
            uniform token mjc:forceLimited = "true"
            uniform double mjc:forceRange:max = 1000
            uniform double mjc:forceRange:min = -1000
            uniform double[] mjc:gainPrm = [200000, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            rel mjc:target = </lrv/Physics/chassis_aft>
        }

        over "aft_steer_sector" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
            uniform double mjc:armature = 0.01
        }

        def MjcActuator "aft_steer_sector_actuator"
        {
            uniform double[] mjc:biasPrm = [0, -408.1632653061225, -40.81632653061225, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:biasType = "affine"
            uniform token mjc:forceLimited = "true"
            uniform double mjc:forceRange:max = 142.85714285714286
            uniform double mjc:forceRange:min = -142.85714285714286
            uniform double[] mjc:gainPrm = [408.1632653061225, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            rel mjc:target = </lrv/Physics/aft_steer_sector>
