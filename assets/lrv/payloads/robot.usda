        </lrv/Geometry/chassis/chassis_fwd/hga_mast/hga_mast_ext/hga_az>,
        </lrv/Geometry/chassis/chassis_fwd/hga_mast/hga_mast_ext/hga_az/hga_el>,
        </lrv/Geometry/chassis/chassis_fwd/hga_mast/hga_mast_ext/hga_az/hga_el/hga_dish>,
        </lrv/Geometry/chassis/chassis_fwd/lcru>,
        </lrv/Geometry/chassis/chassis_fwd/lf_damper_cyl>,
        </lrv/Geometry/chassis/chassis_fwd/lf_damper_cyl/lf_damper_rod>,
        </lrv/Geometry/chassis/chassis_fwd/lf_lower_arm>,
        </lrv/Geometry/chassis/chassis_fwd/lf_lower_arm/lf_upright>,
