        </lrv/Geometry/chassis/chassis_aft/rr_lower_arm/rr_upright/rr_steer/rr_fender_ext>,
        </lrv/Geometry/chassis/chassis_aft/rr_lower_arm/rr_upright/rr_steer/rr_wheel>,
        </lrv/Geometry/chassis/chassis_aft/rr_upper_arm>,
        </lrv/Geometry/chassis/chassis_fwd>,
        </lrv/Geometry/chassis/chassis_fwd/bat1_cover>,
