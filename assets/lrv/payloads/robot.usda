#usda 1.0
(
    customLayerData = {
        string creator = "lrv pipeline (scripts/package_usd.py)"
    }
    defaultPrim = "lrv"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "lrv" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    string isaac:description = "Apollo Lunar Roving Vehicle (LRV-3, Apollo 17)"
    token isaac:license = "Other"
    string isaac:namespace = "lrv"
    prepend rel isaac:physics:robotJoints = [
        </lrv/Physics/chassis_aft>,
        </lrv/Physics/aft_steer_sector>,
        </lrv/Physics/lr_tie_rod>,
        </lrv/Physics/rr_tie_rod>,
        </lrv/Physics/lr_damper_cyl>,
        </lrv/Physics/lr_damper_rod>,
