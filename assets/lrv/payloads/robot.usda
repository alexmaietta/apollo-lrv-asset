        </lrv/Physics/bat1_cover>,
        </lrv/Physics/bat2_cover>,
        </lrv/Physics/fwd_steer_sector>,
        </lrv/Physics/lf_tie_rod>,
        </lrv/Physics/rf_tie_rod>,
        </lrv/Physics/hga_mast>,
        </lrv/Physics/hga_mast_ext>,
        </lrv/Physics/hga_az>,
        </lrv/Physics/hga_el>,
        </lrv/Physics/hga_dish>,
        </lrv/Physics/lcru>,
        </lrv/Physics/lf_damper_cyl>,
        </lrv/Physics/lf_damper_rod>,
        </lrv/Physics/lf_lower_arm>,
        </lrv/Physics/lf_upright>,
        </lrv/Physics/lf_steer>,
        </lrv/Physics/lf_fender_ext>,
        </lrv/Physics/lf_wheel>,
        </lrv/Physics/lf_upper_arm>,
        </lrv/Physics/rf_damper_cyl>,
