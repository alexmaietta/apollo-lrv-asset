        </lrv/Geometry/chassis/chassis_fwd/lf_upper_arm>,
        </lrv/Geometry/chassis/chassis_fwd/rf_damper_cyl>,
        </lrv/Geometry/chassis/chassis_fwd/rf_damper_cyl/rf_damper_rod>,
        </lrv/Geometry/chassis/chassis_fwd/rf_lower_arm>,
        </lrv/Geometry/chassis/chassis_fwd/rf_lower_arm/rf_upright>,
        </lrv/Geometry/chassis/chassis_fwd/rf_lower_arm/rf_upright/rf_steer>,
        </lrv/Geometry/chassis/chassis_fwd/rf_lower_arm/rf_upright/rf_steer/rf_fender_ext>,
        </lrv/Geometry/chassis/chassis_fwd/rf_lower_arm/rf_upright/rf_steer/rf_wheel>,
        </lrv/Geometry/chassis/chassis_fwd/rf_upper_arm>,
        </lrv/Geometry/chassis/chassis_fwd/spu_cover>,
        </lrv/Geometry/chassis/chassis_fwd/tcu>,
        </lrv/Geometry/chassis/chassis_fwd/tcu/tv_pan>,
        </lrv/Geometry/chassis/chassis_fwd/tcu/tv_pan/tv_camera>,
        </lrv/Geometry/chassis/hc_steer>,
        </lrv/Geometry/chassis/hc_steer/hc_brake>,
        </lrv/Geometry/chassis/hc_steer/hc_brake/hc_throttle>,
