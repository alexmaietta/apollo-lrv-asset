        </lrv/Geometry/chassis/chassis_aft/pallet>,
        </lrv/Geometry/chassis/chassis_aft/pallet/extension_handle>,
        </lrv/Geometry/chassis/chassis_aft/pallet/gnomon>,
        </lrv/Geometry/chassis/chassis_aft/pallet/hammer>,
        </lrv/Geometry/chassis/chassis_aft/pallet/rake>,
        </lrv/Geometry/chassis/chassis_aft/pallet/scoop>,
        </lrv/Geometry/chassis/chassis_aft/pallet/sep_antenna>,
        </lrv/Geometry/chassis/chassis_aft/pallet/sep_receiver>,
