                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
            }

            over "seat_h_point_l" (
                prepend apiSchemas = ["IsaacSiteAPI"]
            )
            {
                string isaac:Description = "Commander hip point (suited, PLSS against seat back)"
                uniform token isaac:forwardAxis = "X"
            }

            over "seat_h_point_r" (
                prepend apiSchemas = ["IsaacSiteAPI"]
            )
            {
                string isaac:Description = "LMP hip point (suited, PLSS against seat back)"
                uniform token isaac:forwardAxis = "X"
            }

            over "footrest_l" (
                prepend apiSchemas = ["IsaacSiteAPI"]
            )
            {
                string isaac:Description = "Commander footrest, centre of top surface"
                uniform token isaac:forwardAxis = "X"
            }

            over "footrest_r" (
                prepend apiSchemas = ["IsaacSiteAPI"]
