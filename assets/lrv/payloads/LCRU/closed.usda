#usda 1.0
(
    customLayerData = {
        string creator = "lrv pipeline (github: local ~/code/lrv)"
    }
    defaultPrim = "lrv"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def "lrv"
{
    def "Geometry"
    {
        def "chassis"
        {
            def "chassis_fwd"
            {
                def "lcru"
                {
                    def Xform "eq_lcru_seam_tape_top" (
                        instanceable = true
                        prepend references = @../instances.usda@</Instances/eq_lcru_seam_tape_top>
                    )
                    {
                        quatd xformOp:orient = (1, 0, 0, 0)
                        double3 xformOp:scale = (1, 1, 1)
                        double3 xformOp:translate = (0, 0, 0)
                        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
                    }

                    def Xform "eq_lcru_blanket_top" (
                        instanceable = true
                        prepend references = @../instances.usda@</Instances/eq_lcru_blanket_top>
                    )
                    {
                        quatd xformOp:orient = (1, 0, 0, 0)
                        double3 xformOp:scale = (1, 1, 1)
                        double3 xformOp:translate = (0, 0, 0)
                        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
                    }

                    def Xform "eq_lcru_blanket_edges_top" (
                        instanceable = true
                        prepend references = @../instances.usda@</Instances/eq_lcru_blanket_edges_top>
                    )
                    {
                        quatd xformOp:orient = (1, 0, 0, 0)
                        double3 xformOp:scale = (1, 1, 1)
                        double3 xformOp:translate = (0, 0, 0)
                        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
                    }

                    def Xform "eq_lcru_tape_tabs" (
                        instanceable = true
                        prepend references = @../instances.usda@</Instances/eq_lcru_tape_tabs>
                    )
                    {
                        quatd xformOp:orient = (1, 0, 0, 0)
                        double3 xformOp:scale = (1, 1, 1)
                        double3 xformOp:translate = (0, 0, 0)
                        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
                    }
                }
            }
        }
    }
}

