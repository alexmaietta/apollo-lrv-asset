+@functools.lru_cache(maxsize=None)
+def _texture_band_means(path: str) -> tuple[float, ...]:
+    """Per-band means in [0, 1] of a texture file (cached by path; decoded at native depth)."""
+    try:
+        from PIL import Image, ImageStat  # noqa: PLC0415
+
+        with Image.open(path) as img:
+            if img.mode not in ("L", "LA", "RGB", "RGBA"):
+                img = img.convert("RGBA")
+            return tuple(m / 255.0 for m in ImageStat.Stat(img).mean)
+    except Exception:
+        pixels = load_texture(path)  # URLs and USD package paths
+        if pixels is None:
+            return ()
+        return tuple(float(m) / 255.0 for m in pixels.reshape(-1, pixels.shape[-1]).mean(axis=0))
+
+
+def _texture_channel_mean(path: str, channel: int) -> float | None:
+    """Mean of one texture channel; the scalar stand-in for roughness/metallic maps."""
+    means = _texture_band_means(path)
+    if not means:
+        return None
+    if len(means) <= 2:  # grayscale (+alpha): r/g/b all read the luminance band
+        channel = len(means) - 1 if channel == 3 else 0
+    return means[min(channel, len(means) - 1)]
+
