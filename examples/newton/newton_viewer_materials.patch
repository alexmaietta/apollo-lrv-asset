+def _connected_uv_texture(shader_input: UsdShade.Input | None, prim: Usd.Prim) -> tuple[str, int, UsdShade.Shader] | None:
+    """Resolve the ``UsdUVTexture`` driving ``shader_input``.
+
+    Returns:
+        ``(file path, channel index of the connected output, texture shader)``, or ``None``.
+    """
+    if not shader_input:
+        return None
+    try:
+        source = shader_input.GetConnectedSource()
+    except Exception:
+        return None
+    if not source:
+        return None
+    tex = UsdShade.Shader(source[0].GetPrim())
+    if tex.GetIdAttr().Get() != "UsdUVTexture":
+        return None
+    file_input = tex.GetInput("file")
+    if not file_input:
+        return None
+    attrs = UsdShade.Utils.GetValueProducingAttributes(file_input)
+    attr = attrs[0] if attrs else file_input.GetAttr()
+    path = _resolve_asset_path(attr.Get(), prim, attr)
+    if not path:
+        return None
+    output = str(source[1])
+    channel = "rgba".index(output) if output in ("r", "g", "b", "a") else 0
+    return path, channel, tex
+
