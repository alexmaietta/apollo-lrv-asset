+def _resample_nearest(channel: np.ndarray, shape: tuple[int, int]) -> np.ndarray:
+    if channel.shape == shape:
+        return channel
+    ys = np.arange(shape[0]) * channel.shape[0] // shape[0]
+    xs = np.arange(shape[1]) * channel.shape[1] // shape[1]
+    return channel[ys][:, xs]
+
+
+def _load_orm_image(roughness, metallic) -> np.ndarray | None:
+    """Pack per-texel roughness (R) and metallic (G) maps, each given as ``(path, channel)`` or ``None``.
+
+    B and A flag (255) which of R/G come from a map, so the shader keeps the per-mesh scalar otherwise.
+    """
+    channels = []
+    for spec in (roughness, metallic):
+        image = load_texture(spec[0]) if spec else None
+        channels.append(image[..., spec[1]] if image is not None else None)
+    loaded = [c for c in channels if c is not None]
+    if not loaded:
+        return None
+    shape = max((c.shape for c in loaded), key=lambda hw: hw[0] * hw[1])
+    orm = np.zeros((*shape, 4), dtype=np.uint8)
+    for i, c in enumerate(channels):
+        if c is not None:
+            orm[..., i] = _resample_nearest(c, shape)
+            orm[..., i + 2] = 255
+    return orm
+
+
+def _load_normal_image(path, scale, bias) -> np.ndarray | None:
+    """Tangent-space normal map re-encoded as ``n * 0.5 + 0.5`` (UsdUVTexture ``scale``/``bias`` applied).
+
+    Alpha is 255 to flag a bound normal map.
+    """
+    image = load_texture(path)
+    if image is None:
+        return None
+    image = np.array(image[..., :4], dtype=np.uint8)
+    if tuple(scale) != (2.0, 2.0, 2.0) or tuple(bias) != (-1.0, -1.0, -1.0):
+        n = image[..., :3].astype(np.float32) * (np.asarray(scale, np.float32) / 255.0) + np.asarray(bias, np.float32)
+        image[..., :3] = np.clip((n * 0.5 + 0.5) * 255.0 + 0.5, 0, 255).astype(np.uint8)
+    image[..., 3] = 255
+    return image
+
+
+class _TextureCache:
+    """GL textures shared between meshes by source key (file path or map spec), reference counted."""
+
+    def __init__(self):
+        self._entries = {}  # key -> [texture_id, refcount, source kept alive while its id() is the key]
+
+    @staticmethod
+    def key(kind, source):
+        if isinstance(source, np.ndarray):
+            return (kind, "array", id(source))
+        return (kind, os.fspath(source) if isinstance(source, os.PathLike) else source)
+
+    def acquire(self, key, load, source=None):
+        """Return the texture id for ``key``, uploading ``load()`` on first use (``None`` if unavailable)."""
+        entry = self._entries.get(key)
+        if entry is None:
+            image = load()
+            texture_id = _upload_texture_from_file(RendererGL.gl, image) if image is not None else 0
+            if not texture_id:
+                return None
+            entry = self._entries[key] = [texture_id, 0, source]
+        entry[1] += 1
+        return entry[0]
+
+    def release(self, key):
+        entry = self._entries.get(key)
+        if entry is None:
+            return
+        entry[1] -= 1
+        if entry[1] <= 0:
+            del self._entries[key]
+            try:
+                RendererGL.gl.glDeleteTextures(1, entry[0])
+            except Exception:
+                pass
+
+    def clear(self):
+        """Forget all entries (their GL objects die with the context)."""
+        self._entries.clear()
+
